# Base upstream animein (tanpa slash di akhir)
BASE_API=https://xyz-api.animein.net/3/2

# Port server lokal
PORT=3000

# Transport: auto (default) | 1 (paksa curl) | 0 (paksa undici)
# curl WAJIB karena upstream memfilter fingerprint TLS Node (undici -> 403).
USE_CURL=auto

# Mode gambar: proxy (default, lewat /v1/img) | direct | source
IMG_MODE=proxy

# Mode /v1/proxy: redirect (default, 302 ke CDN) | pipe (stream lewat server)
PROXY_MODE=redirect

# Timeout upstream (ms)
UPSTREAM_TIMEOUT_MS=15000

# Referer yang diminta host asset animein
REFERER_SITE=https://animeinweb.com/

# Opsional: origin publik kalau di belakang proxy/CDN
# PUBLIC_ORIGIN=https://api.contoh.com

# Opsional: log tiap request
# LOG=1
